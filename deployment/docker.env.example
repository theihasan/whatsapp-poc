# Laravel environment for deployment/docker-compose.yml. Copy to docker.env (gitignored).
APP_NAME="WhatsApp Workspace"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_PORT=3306
DB_DATABASE=whatsapp_workspace
DB_USERNAME=workspace
DB_PASSWORD=
DB_ROOT_PASSWORD=

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb
LOG_CHANNEL=stderr

MESSAGING_DEFAULT_PROVIDER=mock
MESSAGING_UNOFFICIAL_ENABLED=false
GATEWAY_API_TOKEN=
GATEWAY_WEBHOOK_SECRET=

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Public host/port browsers use (nginx). REVERB_HOST/PORT for server-side
# publishing are set to the internal reverb container in docker-compose.yml.
PUBLIC_HOST=localhost
HTTP_PORT=8000
