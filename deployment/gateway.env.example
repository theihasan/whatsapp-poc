# Internal WhatsApp gateway. Bind to a private interface only; never expose publicly.
NODE_ENV=production
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=3100

# Shared with Laravel (GATEWAY_API_TOKEN). Generate: openssl rand -hex 32
GATEWAY_API_TOKEN=
# Laravel webhook endpoint and HMAC secret (GATEWAY_WEBHOOK_SECRET in Laravel). openssl rand -hex 32
GATEWAY_WEBHOOK_URL=http://127.0.0.1:8000/api/gateway/events
GATEWAY_WEBHOOK_SECRET=

# Encrypts WhatsApp credentials and Signal keys at rest. 32 bytes, base64:
#   openssl rand -base64 32
# Keep it separate from Laravel's APP_KEY. Losing it means every device must be re-linked.
GATEWAY_STATE_KEY=

# Holds gateway.sqlite (encrypted auth state, webhook outbox) and temporary media.
GATEWAY_DATA_DIR=/data

# baileys = real WhatsApp Web (unofficial). mock = deterministic fake for demos/tests.
GATEWAY_ADAPTER=baileys
# Mock only: auto-"scan" the QR after this many ms (0 = never).
GATEWAY_MOCK_AUTO_CONNECT_MS=0

GATEWAY_LOG_LEVEL=info
GATEWAY_MAX_RECONNECT_ATTEMPTS=8
GATEWAY_RECONNECT_BASE_MS=2000
GATEWAY_RECONNECT_MAX_MS=120000
GATEWAY_QR_TTL_SECONDS=20
GATEWAY_SEND_TIMEOUT_MS=15000
GATEWAY_MAX_MEDIA_BYTES=16777216
GATEWAY_BODY_LIMIT_BYTES=25165824
GATEWAY_WEBHOOK_TIMEOUT_MS=10000
GATEWAY_WEBHOOK_MAX_ATTEMPTS=25
