APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=whatsapp_workspace
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- WhatsApp Workspace ---------------------------------------------------
# Provider for new devices: mock | unofficial_web | official_cloud
MESSAGING_DEFAULT_PROVIDER=mock
# Baileys / WhatsApp Web is unofficial: enable only for consenting test accounts.
MESSAGING_UNOFFICIAL_ENABLED=false
MESSAGING_QR_TTL=60
MESSAGING_ATTACHMENT_DISK=local
MESSAGING_ATTACHMENT_MAX_KB=16384

# Internal gateway (services/whatsapp-gateway). Never expose it publicly.
GATEWAY_URL=http://127.0.0.1:3100
# Both must match the gateway's .env. Generate with: openssl rand -hex 32
GATEWAY_API_TOKEN=
GATEWAY_WEBHOOK_SECRET=
# Set during secret rotation only (docs/gateway-api.md).
GATEWAY_WEBHOOK_SECRET_PREVIOUS=
GATEWAY_SIGNATURE_TOLERANCE=300
GATEWAY_TIMEOUT=15
GATEWAY_CONNECT_TIMEOUT=3

# Official WhatsApp Business Cloud API (requires an authorized Meta account).
WHATSAPP_CLOUD_API_VERSION=v25.0
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=

# Security headers. CSP defaults to on outside APP_ENV=local.
# SECURITY_CSP_ENABLED=true
# SECURITY_WS_ORIGIN=wss://workspace.example.com
# SECURITY_HSTS=true

# Retention in days (app:prune-records).
RETENTION_GATEWAY_EVENTS_DAYS=30
RETENTION_AUTOMATION_EXECUTIONS_DAYS=90
RETENTION_DEVICE_EVENTS_DAYS=180
RETENTION_AUDIT_LOGS_DAYS=365
RETENTION_READ_NOTIFICATIONS_DAYS=30
